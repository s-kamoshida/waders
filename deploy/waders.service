# Waders を systemd のサービスとして動かすための定義ファイル。
# Raspberry Pi（Homebridge の Raspbian イメージ）で、Homebridge の Node.js を共用する前提。
# 配置先: /etc/systemd/system/waders.service（手順は README の「Raspberry Pi へのインストール」）

[Unit]
Description=Waders（ホビーの予約購入の管理）
After=network-online.target
Wants=network-online.target
# 設定の誤りなどで起動に失敗し続ける場合は、60秒間に3回で再起動をあきらめる
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/waders
ExecStart=/opt/homebridge/bin/node src/server/main.ts
# ポートやデータのフォルダを変える場合は、data/settings.json を編集するか、ここで環境変数を指定する
# Environment=WADERS_PORT=8080
Restart=on-failure
RestartSec=5
# 作成するファイルを所有者だけが読み書きできるようにする
UMask=0077
# 書き込めるのはデータのフォルダだけにする
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/pi/waders/data

[Install]
WantedBy=multi-user.target
